{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "description": "Clock in, pause and clock out on clockin.de from the BUSY Bar",
  "author": "Simon",
  "type": "module",
  "scripts": {
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
